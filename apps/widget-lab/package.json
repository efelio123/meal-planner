{
  "name": "meal-planner-widget-lab",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --localhost",
    "typecheck": "tsc --noEmit",
    "audit:sdk": "node scripts/audit-sdk.mjs",
    "test": "node --test scripts/*.test.mjs",
    "export": "expo export --platform ios --platform android",
    "build:runtime:ios": "node node_modules/expo-widgets/scripts/build-bundle.mjs . ios artifacts/ExpoWidgets-ios.bundle",
    "build:runtime:android": "node node_modules/expo-widgets/scripts/build-bundle.mjs . android artifacts/ExpoWidgets-android.bundle",
    "test:bundles": "node scripts/test-sdk-bundles.mjs"
  },
  "dependencies": {
    "expo": "58.0.22",
    "expo-widgets": "58.0.26",
    "@expo/ui": "58.0.26",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/react": "~19.3.0"
  }
}
